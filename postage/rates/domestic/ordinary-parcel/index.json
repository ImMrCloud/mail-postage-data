{
  "schemaVersion": 6,
  "standardVersion": "1.5.0",
  "scope": "domestic",
  "rateCategory": "delivery",
  "serviceId": "DOMESTIC_ORDINARY_PARCEL",
  "mailType": "PARCEL",
  "currency": "CNY",
  "weightUnit": "g",
  "regionRegistry": "../../../domestic/provinces.json",
  "pricingType": "weight_band_base_plus_increment_by_route_group",
  "weightBands": [
    {"id":"UP_TO_10KG","minWeightExclusive":0,"maxWeight":10000,"baseWeight":1000,"incrementWeight":1000,"rounding":"ceil"},
    {"id":"OVER_10_TO_20KG","minWeightExclusive":10000,"maxWeight":20000,"baseWeight":1000,"incrementWeight":1000,"rounding":"ceil"},
    {"id":"OVER_20_TO_50KG","minWeightExclusive":20000,"maxWeight":50000,"baseWeight":1000,"incrementWeight":1000,"rounding":"ceil"}
  ],
  "volumetricWeight": {
    "optional": true,
    "dimensionUnit": "cm",
    "resultUnit": "kg",
    "divisor": 6000,
    "formula": "lengthCm * widthCm * heightCm / 6000",
    "comparisonRule": "higher-postage",
    "consumerBehavior": "若用户输入完整长宽高，分别使用实际重量和体积重量按同一路向规则计算资费，展示两项结果，并以较高资费作为应计寄递资费；若未输入完整尺寸则仅按实际重量计算。"
  },
  "serviceCapabilities": {
    "registrationIncludedInDeliveryPostage": true,
    "insurance": {"available": true, "rateId":"DOMESTIC_PARCEL_INSURANCE_FEE", "maximumInsuredValue":100000.0, "conflictsWith": []},
    "adviceOfDelivery": {"available": true, "rateId":"ADVICE_OF_DELIVERY_FEE", "registrationRequirementSatisfiedByService": true, "requiresRateIds": [], "conflictsWith": []}
  },
  "originFiles": {
    "CN-SC":"./CN-SC.json",
    "CN-ZJ":"./CN-ZJ.json",
    "CN-JS":"./CN-JS.json",
    "CN-GD":"./CN-GD.json",
    "CN-HE":"./CN-HE.json",
    "CN-SD":"./CN-SD.json",
    "CN-BJ":"./CN-BJ.json",
    "CN-JX":"./CN-JX.json",
    "CN-HN":"./CN-HN.json"
  },
  "unpopulatedOrigins": ["CN-TJ","CN-SX","CN-NM","CN-LN","CN-JL","CN-HL","CN-SH","CN-AH","CN-FJ","CN-HA","CN-HB","CN-GX","CN-HI","CN-CQ","CN-GZ","CN-YN","CN-XZ","CN-SN","CN-GS","CN-QH","CN-NX","CN-XJ"],
  "availableSpecialRateIds": ["ADVICE_OF_DELIVERY_FEE","DOMESTIC_PARCEL_INSURANCE_FEE"],
  "discounts": {
    "appliesToServiceIds": ["DOMESTIC_ORDINARY_PARCEL"],
    "excludedServiceIds": ["DOMESTIC_HOMETOWN_PARCEL_STICKER"],
    "applyTo": "baseDeliveryPostageOnly",
    "excludedChargeCategories": ["special"],
    "combinationPolicy": "single",
    "maxCredentialsPerShipment": 1,
    "credentials": [
      {"id":"STUDENT_ID","nameZh":"学生证","status":"active","pricing":{"type":"multiplier","multiplier":0.8}},
      {"id":"TEACHER_ID","nameZh":"教师证","status":"active","pricing":{"type":"multiplier","multiplier":0.8}},
      {"id":"DISCOUNT_CARD","nameZh":"优惠卡","status":"active","pricing":{"type":"multiplier","multiplier":0.8}},
      {"id":"DISABILITY_CERTIFICATE","nameZh":"残疾证","status":"active","pricing":{"type":"multiplier","multiplier":0.7}},
      {"id":"MILITARY_OFFICER_ID","nameZh":"军官证","status":"active","pricing":{"type":"multiplier","multiplier":0.7}},
      {"id":"POLICE_OFFICER_ID","nameZh":"警官证","status":"active","pricing":{"type":"multiplier","multiplier":0.7}},
      {"id":"CIVILIAN_PERSONNEL_ID","nameZh":"文职人员证","status":"active","pricing":{"type":"multiplier","multiplier":0.7}},

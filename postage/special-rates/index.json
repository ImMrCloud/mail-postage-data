{
  "schemaVersion": 9,
  "standardVersion": "1.2.0",
  "dataset": "China Post special business rates",
  "currency": "CNY",
  "notices": "./notices.json",
  "scopes": {
    "international": {
      "status": "active",
      "destinationIndependent": true,
      "rateFile": "./international.json"
    },
    "domestic": {
      "status": "active",
      "destinationIndependent": true,
      "rateFile": "./domestic.json"
    },
    "hong-kong-macau-taiwan": {
      "status": "active",
      "destinationIndependent": false,
      "destinations": ["HK", "MO", "TW"],
      "rateFile": "./hong-kong-macau-taiwan.json"
    }
  }
}

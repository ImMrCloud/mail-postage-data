{
  "schemaVersion": 5,
  "standardVersion": "1.5.0",
  "scope": "domestic",
  "rateCategory": "special",
  "category": "special-business-rates",
  "currency": "CNY",
  "destinationIndependent": true,
  "rates": [
    {
      "id": "REGISTRATION_FEE",
      "nameZh": "挂号费",
      "applicableCategories": ["LETTER_POST"],
      "selection": {"mode":"selectable","phase":"acceptance","chargedTo":"sender"},
      "pricing": {"type":"flat","unit":"item","price":3.0}
    },
    {
      "id": "APPOINTED_DELIVERY_FEE",
      "nameZh": "约投服务费",
      "applicableMailTypes": ["LETTER"],
      "selection": {"mode":"selectable","phase":"acceptance","chargedTo":"sender"},
      "dependencies": {"excludesRateIds":["INSURANCE_FEE_RECORDED_LETTER"]},
      "pricing": {"type":"flat","unit":"item","price":2.0},
      "noteZh": "仅适用于国内信函；不能与保价同时使用。"
    },
    {
      "id": "ADVICE_OF_DELIVERY_FEE",
      "nameZh": "回执",
      "applicableCategories": ["LETTER_POST"],
      "applicableServiceIds": ["DOMESTIC_ORDINARY_PARCEL"],
      "excludedServiceIds": ["DOMESTIC_HOMETOWN_PARCEL_STICKER"],
      "selection": {"mode":"selectable","phase":"acceptance","chargedTo":"sender"},
      "dependencies": {
        "requiresAnyRateIds": ["REGISTRATION_FEE", "INSURANCE_FEE_RECORDED_LETTER"],
        "serviceSatisfiedBy": {"DOMESTIC_ORDINARY_PARCEL":"registrationIncludedInDeliveryPostage"}
      },
      "pricing": {"type":"flat","unit":"item","price":3.0},
      "noteZh": "函件回执须有挂号；若已办理保价，则保价所需挂号满足回执前提。普通包裹基础资费自带挂号，因此附回执不另收挂号费。家乡包裹贴不可回执。"
    },
    {
      "id": "INSURANCE_FEE_RECORDED_LETTER",
      "nameZh": "保价费（信函/盲人读物）",
      "applicableMailTypes": ["LETTER", "LITERATURE_FOR_BLIND"],
      "selection": {"mode":"selectable","phase":"acceptance","chargedTo":"sender"},
      "dependencies": {"requiresRateIds":["REGISTRATION_FEE"],"excludesRateIds":["APPOINTED_DELIVERY_FEE"]},
      "pricing": {
        "type":"value_increment_with_minimum",
        "valueIncrement":1,
        "incrementPrice":0.01,
        "rounding":"ceil",
        "minimumPrice":1.0,
        "maximumInsuredValue":20000.0
      },
      "noteZh": "适用于国内信函和盲人读物；办理保价必须挂号；最高保价金额20000元；与约投互斥。盲人读物在其业务允许重量范围内基本资费仍为0元，保价费和挂号费作为特别业务另计。"
    },
    {
      "id": "DOMESTIC_PARCEL_INSURANCE_FEE",
      "nameZh": "包裹保价费",
      "applicableServiceIds": ["DOMESTIC_ORDINARY_PARCEL", "DOMESTIC_HOMETOWN_PARCEL_STICKER"],
      "selection": {"mode":"selectable","phase":"acceptance","chargedTo":"sender"},
      "pricing": {"type":"declared_value_percentage","percentage":0.01,"maximumInsuredValue":100000.0},
      "noteZh": "普通包裹和家乡包裹贴均可保价，保价费为保价金额的1%，最高保价金额100000元。"
    },
    {
      "id": "POSTE_RESTANTE_HANDLING_FEE",
      "nameZh": "存局候领手续费",
      "applicableCategories": ["LETTER_POST"],
      "selection": {"mode":"display-only","phase":"delivery","chargedTo":"recipient","displayOrder":"last"},
      "pricing": {"type":"flat","unit":"item","price":1.0},
      "noteZh": "由收件人承担，仅公示，不作为寄件时可选项目；普通包裹不提供此项。"
    },
    {
      "id": "WITHDRAW_OR_CHANGE_ADDRESSEE_FEE",
      "nameZh": "撤回邮件或更改收件人名址手续费",
      "selection": {"mode":"display-only","phase":"post-acceptance","chargedTo":"sender","displayOrder":"last"},
      "pricing": {"type":"flat","unit":"item","price":3.0},
      "noteZh": "属于交寄后的申请手续费，仅公示，不作为寄件时可选项目。"
    }
  ],
  "notes": [
    "selection.mode=display-only 的项目只公示，必须排在可选业务之后，且不得渲染为复选框。",
    "国内信函和盲人读物均可办理保价；保价必须挂号，最高保价金额2万元。",
    "盲人读物在其业务允许重量范围内基本资费为0元；挂号、回执、保价等特别业务按规则另计。",
    "约投仅适用于信函，并与保价互斥。",
    "取消挂号时，依赖挂号的回执和保价必须级联取消。",
    "普通包裹基础资费已包含挂号属性；普通包裹附回执不另选、不另收挂号费。",
    "普通包裹和家乡包裹贴保价费均为保价金额1%，最高保价金额10万元。"
  ]
}
